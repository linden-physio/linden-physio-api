{
  "name": "linden-physio-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --watch server.ts",
    "build": "node migrate.ts",
    "typecheck": "tsc",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=.env migrate.ts",
    "seed": "node --env-file-if-exists=.env seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
