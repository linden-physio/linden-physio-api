# Copy this file to .env and fill it in. .env is never committed.

# The clinic's database. With Docker Compose (compose.yaml) on this computer:
DATABASE_URL=postgres://linden:linden@localhost:5432/linden
# The tests' own database, which they empty every time.
TEST_DATABASE_URL=postgres://linden:linden@localhost:5432/linden_test
# The pages that may read our answers, separated by commas. A * stands for any run of letters, digits
# and dashes, for preview addresses like https://linden-physio-*-linden-physio.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
